<% layout("/layouts/boilerplate") %>

    <div class="row">
        <div class="col-8 offset-3 mt-3">
            <h3>
                <%= listing.title %>
            </h3>
        </div>
        <div class="card col-6 offset-3 show-card">
            <img src="<%= listing.image.url %>" class="card-img-top show-img mb-3" alt="listing_image">
            <div class="card-body">
                <p class="card-text">
                    <%= listing.description %><br>
                        &#8377; <%= listing.price.toLocaleString("en-IN") %> <br>
                            <%= listing.location %> <br>
                                <%= listing.country %>
                </p>
            </div>
        </div>
        <div class="btns">
            <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark offset-3">Edit</a>

            <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST">
                <button class="btn btn-dark add-btn offset-3">Delete</button>
            </form>
        </div>
        <!-- form for reviews -->
        <div class="col-8 offset-3 mt-3">
            <hr />
            <h4 class="mb-3">Leave a review</h4>
            <form action="/listings/<%= listing.id %>/reviews" method="POST"  novalidate class="needs-validation">
                <div class="mb-3">
                    <label for="rating" class="form-label">Rating</label>
                    <input type="range" min="1" max="5" id="rating" name="review[rating]" id="rating" class="form-range">
                </div>
                <div class="mb-3">
                    <label for="comment" class="form-label">Comments</label>
                    <textarea name="review[comment]" id="comment" class="form-control" required></textarea>
                    <div class="invalid-feedback">Please submit some comments for reviews</div>
                </div>
                <div class="mb-3">
                    <button class="btn btn-outline-dark">Submit</button>
                </div>
            </form>
        </div>

    </div>

    <script src="/js/script.js"></script>